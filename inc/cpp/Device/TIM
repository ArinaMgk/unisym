	// Haruno saw most parameters are compatible
	namespace TimReg {
		typedef enum {
			// : control register
			CR1,   // 0x00
			CR2,   // 0x04
			SMCR,  // TIM slave Mode Control register,            0x08
			DIER,  // TIM DMA/interrupt enable register,          0x0C
			SR,    // TIM status register,                        0x10
			EGR,   // TIM event generation register,              0x14
			// : capture/compare mode register
			CCMR1, // 0x18
			CCMR2, // 0x1C
			CCER,  // TIM capture/compare enable register,        0x20
			CNT,   // TIM counter register,                       0x24
			PSC,   // TIM prescaler register,                     0x28
			ARR,   // TIM auto-reload register,                   0x2C
			RCR,   // TIM  repetition counter register,           0x30
			// : capture/compare register
			CCR1,  // 0x34
			CCR2,  // 0x38
			CCR3,  // 0x3C
			CCR4,  // 0x40
			BDTR,  // TIM break and dead-time register,           0x44
			DCR,   // TIM DMA control register,                   0x48
			DMAR,  // TIM DMA address for full transfer register, 0x4C
			OR,    // TIM option register,                        0x50 (F1/F4; H7/MP13 reserved)
#if defined(_MCU_STM32H7x) || defined(_MPU_STM32MP13)
			_RSV1, // TIM capture/compare mode register 3,        0x54
			CCR5,  // TIM capture/compare register 5,             0x58
			_RSV2, // TIM capture/compare register 6,             0x5C
			AF1,   // TIM alternate function option register 1,   0x60
			AF2,   // TIM alternate function option register 2,   0x64
			TISEL, // TIM input selection register,               0x68
#endif
		} TimRegType;
	}

	namespace TimChinSel { // TIM Channel Input Selection
		typedef enum {// TIM Input 1~4 selected to whom respectively
			Direct = 1, // IC1, IC2, IC3 or IC4
			Indirect = 2, // IC2, IC1, IC4 or IC3
			TRC = 3 // TRC
		} TimChinSel;
	}

	namespace TimOutMode { // TIM Output Compare modes (CCMRx.OCxM)
		typedef enum : stduint {
			Frozen = 0x0,       // output frozen, no compare action
			Active = 0x1,       // set output active on match
			Inactive = 0x2,     // set output inactive on match
			Toggle = 0x3,       // toggle output on match
			ForceInactive = 0x4,// force output inactive (no compare)
			ForceActive = 0x5,  // force output active (no compare)
			PWM1 = 0x6,         // PWM mode 1 (active when CNT < CCR)
			PWM2 = 0x7,         // PWM mode 2 (inactive when CNT < CCR)
		} TimOutMode;
	}

	namespace TIMMode { // TIM working mode selector (setMode)
		typedef enum {
			OnePulse,   // single-pulse mode (CR1.OPM = 1)
			Encoder,    // encoder interface mode (SMCR.SMS = 3, dual-edge)
			HallSensor, // hall sensor interface mode (XOR + TI1F_ED + Reset)
		} TIMMode;
	}

	namespace TimIcPol { // TIM input polarity (CCxP)
		typedef enum {
			Rising = 0,  // rising edge / active high (CCxP = 0)
			Falling = 1, // falling edge / active low (CCxP = 1)
		} TimIcPol;
	}

	namespace TimClockSrc { // TIM clock source selector (ConfigClock)
		typedef enum {
			Internal, // internal clock (CK_INT)
			ETRMode1, // external clock mode 1 (ETR, SMS=0x7 + TS=ETRF)
			ETRMode2, // external clock mode 2 (SMCR.ECE)
			TI1,      // external clock mode 1 (TI1FP1)
			TI2,      // external clock mode 1 (TI2FP2)
			TI1ED,    // external clock mode 1 (TI1 edge detector)
			ITR0,     // internal trigger 0 (TS=0)
			ITR1,     // internal trigger 1 (TS=1)
			ITR2,     // internal trigger 2 (TS=2)
			ITR3,     // internal trigger 3 (TS=3)
		} TimClockSrc;
	}

	namespace TimTi1Sel { // TIM TI1 input selection (CR2.TI1S)
		typedef enum {
			Direct = 0, // CH1 pin -> TI1
			XOR = 1,    // CH1 ^ CH2 ^ CH3 -> TI1
		} TimTi1Sel;
	}

	namespace TimOcrefSrc { // TIM OCxREF clear source (ConfigOcrefClear)
		typedef enum {
			None = 0, // no clear source
			ETR = 1,  // ETR as clear source
		} TimOcrefSrc;
	}

	namespace TimEvSrc { // TIM software event source (GenerateEvent, EGR)
		typedef enum {
			Update = 0,  // UG
			CC1 = 1,     // CC1G
			CC2 = 2,     // CC2G
			CC3 = 3,     // CC3G
			CC4 = 4,     // CC4G
			Commute = 5, // COMG
			Trigger = 6, // TG
			Break = 7,   // BG
		} TimEvSrc;
	}

	namespace TimBurstSrc { // TIM DMA burst request source (BurstWrite/BurstRead)
		typedef enum {
			Update = 0, // dma[0], DIER.UDE
			CC1 = 1,    // dma[1], DIER.CC1DE
			CC2 = 2,    // dma[2], DIER.CC2DE
			CC3 = 3,    // dma[3], DIER.CC3DE
			CC4 = 4,    // dma[4], DIER.CC4DE
		} TimBurstSrc;
	}

	namespace TimCommutSrc { // TIM commutation event source (CR2.CCUS)
		typedef enum {
			Trgi = 0,     // commutation on TRGI (interface timer trigger)
			Software = 1, // commutation by software (COMG bit)
		} TimCommutSrc;
	}

