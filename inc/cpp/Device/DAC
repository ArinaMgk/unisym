#if defined(_MCU_STM32F1x) || defined(_MCU_STM32F4x) || defined(_MCU_STM32H7x)

	#define DAC_getStdvol(i) ((float)i*2.5/0x1000)
	#define _DAC_ALIGN_12B_R 0x00000000U
	#define _DAC_ALIGN_12B_L 0x00000004U
	#define _DAC_ALIGN_8B_R  0x00000008U
	class DACChan;
	class DAC_t
		#if 0
		: public RuptTrait
		#endif
	{
	protected:
		stduint baseaddr;
		//{MEANINGLESS} byte DAC_ID;
		pureptr_t bind;
	public:
		DAC_t(stduint baseaddr) : baseaddr(baseaddr), bind(0){ }
		stduint getBaseAddr() { return baseaddr; }
		//{MEANINGLESS} byte getID() { return DAC_ID; }

		Reference operator[](DACReg::DACRegType idx) {
			return Reference(baseaddr + (((stduint)idx) << 2));
		}
		
		bool enClock(bool ena = true);

		void enAble(byte channel, bool ena = true) {
			if (channel != 1 && channel != 2) return;
			self[DACReg::CR].setof(_DAC_CR_POS_ENx + (channel - 1) * 16 , ena);
		}

		byte getChannel(const GPIO_Pin& pin) const {
			if (&pin == &GPIOA[4])
				return 1;
			else if (&pin == &GPIOA[5])
				return 2;
			return 0;
		}
		GPIO_Pin* getPin(byte channel) {
			if (channel == 1)
				return &GPIOA[4];
			else if (channel == 2)
				return &GPIOA[5];
			return 0;
		}
		const DACChan& operator[](const GPIO_Pin& pin) const {
		    return *(const DACChan*)_IMM(getChannel(pin));
		}

		void setOutput(byte channel, uint16 val);
		uint16 getValue(byte channel);
		void Stop(byte channel) {
			enAble(channel, false);
		}
		bool StopDMA(byte channel);

		void setOutput(GPIO_Pin& pin, uint16 val) {
			byte channel = getChannel(pin);
			if (!channel) return;
			setOutput(channel, val);
		}
		uint16 getValue(const GPIO_Pin& pin) {
			byte channel = getChannel(pin);
			return channel ? getValue(channel) : 0;
		}
		void Stop(const GPIO_Pin& pin) {
			byte channel = getChannel(pin);
			if (!channel) return;
			Stop(channel);
		}
		bool StopDMA(const GPIO_Pin& pin) {
			byte channel = getChannel(pin);
			return channel ? StopDMA(channel) : false;
		}

		#ifdef _MCU_STM32F1x //{TEMP}
		bool enDMA(GPIO_Pin& pin, DACTrigger::DACTrigger trigger, bool buffer_enable, pureptr_t data, uint32_t leng, uint32_t align = 0);
		#elif defined(_MCU_STM32F4x)
		bool enAble(GPIO_Pin& pin);
		#elif defined(_MCU_STM32H7x)
		bool enAble(GPIO_Pin& pin);
		bool canMode();
		bool setTrigger(byte channel, DACTrigger::DACTrigger trigger);
		bool setWave(byte channel, DACWave::DACWave wave, byte amplitude);
		bool setBuffer(byte channel, bool ena);
		bool enDMA(GPIO_Pin& pin, const DMAStream& stream, pureptr_t data, uint32_t leng, uint32_t align = 0);
		bool setOutputs(uint32 val1, uint32 val2, uint32 align = _DAC_ALIGN_12B_R);
		bool swTrigger(byte channel);
		bool setValue(byte channel, uint32 data, uint32 align);
		bool setSampleHold(byte channel, uint32 sampleTime, uint32 holdTime, uint32 refreshTime);
		bool setUserTrimming(byte channel, uint32 trimValue);
		bool setChipConnect(byte channel, bool ena);
		bool setCalibrationEnable(byte channel, bool ena);
		void getOutputs(uint16& val1, uint16& val2);
		uint32 selfCalibrate(byte channel);
		uint32 getTrimOffset(byte channel);
		#endif
		
	};

