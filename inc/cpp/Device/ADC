	enum class ADCEvent : byte {
		EOSMP = _ADC_ISR_POS_EOSMP,// End Of Sampling
		AWD1 = _ADC_ISR_POS_AWD1,// Analog watchdog 1
		AWD2 = _ADC_ISR_POS_AWD2,// Analog watchdog 2
		AWD3 = _ADC_ISR_POS_AWD3 // Analog watchdog 3
	};
#endif

	class ADC_t : public RuptTrait, public IstreamTrait {
	protected:
		byte ADC_ID;
		pureptr_t bind;
		byte getChannelNumber(GPIO_Pin& pin);
	public:
		_COM_DEF_Interrupt_Interface();
		ADC_t(byte _ADC_ID) : ADC_ID(_ADC_ID) { bind = 0; }
		stduint getBaseAddr() const;
		byte getID() const { return ADC_ID; }
		Reference operator[](ADCReg idx) const {
			return getBaseAddr() + _IMMx4((stduint)idx);
		}
		Reference Common(ADCCom idx) const {
			return getBaseAddr() + _IMMx4((stduint)idx);
		}
		// aka HAL_ADC_MspInit + CCR clock config
		bool enClock(bool ena = true, byte presc = 0);
		// aka ADC_Enable / ADC_Disable
		bool enAble(bool ena = true) const;
		// aka HAL_ADC_Init
		bool setMode(ADCRes res = ADCRes::B12, stduint numsof_conv = 0, stduint trigger_ext = 0, bool cont = false);
		// aka HAL_ADC_ConfigChannel
		bool setChannel(GPIO_Pin& pin, byte rank = 0, ADCSample sample = ADCSample::CYCL_64_5);
		// aka HAL_ADC_Start / Start_IT / Start_DMA
		bool Start(IOMethod method = IOMethod::Loop);
		// aka HAL_ADC_Stop / Stop_IT / Stop_DMA
		bool Stop(IOMethod method = IOMethod::Loop);
		// aka HAL_ADC_PollForConversion
		bool Poll(stduint timeout = 0xFFFF);
		// aka HAL_ADCEx_Calibration_Start
		uint32 Calibrate();
		// aka HAL_ADC_DeInit
		bool canMode();
		// aka HAL_ADC_GetValue
		int inn() override {
			return self[ADCReg::DR];
		}
		ADC_t& operator>> (uint32_t& val) {
			val = inn();
			return self;
		}
		ADC_t& operator>> (float& val) {
			val = float _IMM(inn()) / 4095;
			return self;
		}
		// bind DMA stream used by enDMA / enMultiDMA
		bool setDMA(const DMAStream& stream);
		// aka HAL_ADC_Start_DMA
		bool enDMA(pureptr_t addr, stduint leng);
		// aka HAL_ADC_Stop_DMA
		bool StopDMA();
		// aka HAL_ADC_AnalogWDGConfig (watchdog 1, single channel)
		bool setWatchdog(stduint low, stduint high, byte channel = 0);
		// aka HAL_ADC_GetState busy check
		bool isBusy() const;
		// aka HAL_ADC_GetError
		uint32 getError() const;
		// aka HAL_ADCEx_Calibration_GetValue
		uint32 getCalibration() const;
		// aka HAL_ADCEx_Calibration_SetValue (single-ended factor)
		bool setCalibration(uint32 factor);
#if defined(_MCU_STM32H7x)
		// aka HAL_ADCEx_LinearCalibration_GetValue / SetValue
		bool getLinearCalibration(uint32* buffer) const;
		bool setLinearCalibration(const uint32* buffer);
#endif
		// aka HAL_ADCEx_InjectedStart
		bool StartInject();
		// aka HAL_ADCEx_InjectedStop
		bool StopInject();
		// aka HAL_ADCEx_InjectedPollForConversion
		bool PollInject(stduint timeout = 0xFFFF);
		// aka HAL_ADCEx_InjectedGetValue
		uint32 getInjectValue(byte rank = 0);
		// aka HAL_ADCEx_InjectedConfigChannel
		bool setInjectChannel(GPIO_Pin& pin, byte rank = 0, ADCSample sample = ADCSample::CYCL_64_5);
		// aka HAL_ADCEx_EnableInjectedQueue / DisableInjectedQueue
		bool enInjectQueue(bool ena = true);
		// aka HAL_ADCEx_MultiModeConfigChannel
		bool setMultiMode(stduint mode, stduint dual_data = 0, stduint delay = 0);
		// aka HAL_ADCEx_MultiModeStart_DMA
		bool enMultiDMA(pureptr_t addr, stduint leng);
		// aka HAL_ADCEx_MultiModeStop_DMA
		bool StopMultiDMA();
		// aka HAL_ADCEx_MultiModeGetValue
		uint32 getMultiValue();
		// aka HAL_ADCEx_DisableVoltageRegulator (ena=false) / HAL_ADC_Init VREG enable (ena=true)
		bool enVoltageRegulator(bool ena = true);
		// aka HAL_ADCEx_EnterADCDeepPowerDownMode
		bool enDeepPowerDown(bool ena = true);
		// aka HAL_ADC_RegisterCallback (single-callback model)
		void setCallback(ADCCallbackID id, Handler_t f) const;
#if defined(_MPU_STM32MP13)
		// aka HAL_ADC_PollForEvent
		bool PollEvent(ADCEvent event, stduint timeout = 0xFFFF);
		// aka HAL_ADC_StartSampling / StopSampling
		bool enSampling(bool ena = true);
#endif
	};

	static struct ADC_Global {
		ADC_t& operator[](byte id);
	} ADC;

