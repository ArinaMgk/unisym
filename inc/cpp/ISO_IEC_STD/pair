#ifndef _INCPP_Pair_NEXT
#define _INCPP_Pair_NEXT

#ifdef __clang__
#pragma GCC diagnostic push
#pragma GCC diagnostic ignored "-Winclude-next-absolute-path"
#endif

#if defined(__has_include_next)
#	if __has_include_next(<utility>)
#		include_next <utility>
#		define _HAS_STD_PAIR
#	endif
#endif

#ifdef __clang__
#pragma GCC diagnostic pop
#endif

#endif

#ifndef _INCPP_Pair
#define _INCPP_Pair

#include "../unisym"

namespace uni {

	template <typename type1, typename type2>
	struct Pair {
		type1 first;
		type2 second;

		constexpr Pair() : first(), second() {}
		constexpr Pair(const type1& _first, const type2& _second)
			: first(_first), second(_second) {}

		template <typename other1, typename other2>
		constexpr Pair(const Pair<other1, other2>& oth)
			: first(oth.first), second(oth.second) {}

		Pair& operator=(const Pair&) = default;
	};

	template <typename type1, typename type2>
	constexpr bool operator==(const Pair<type1, type2>& lhs, const Pair<type1, type2>& rhs) {
		return lhs.first == rhs.first && lhs.second == rhs.second;
	}

	template <typename type1, typename type2>
	constexpr bool operator!=(const Pair<type1, type2>& lhs, const Pair<type1, type2>& rhs) {
		return !(lhs == rhs);
	}

}

// Keep "std::pair" spelled code compilable without any C++ standard library.
#if !defined(_HAS_STD_PAIR)
namespace std {
	template <typename type1, typename type2> using pair = uni::Pair<type1, type2>;
}
#endif

#endif
