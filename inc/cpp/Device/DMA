	#define _DMA_Group(regname, start) \
		static struct {\
			DMARegType operator[](byte idx) {\
				if (!idx || idx > 7) return start;\
				return (DMARegType)(_IMM(start) + _DMA_Group_Span * (idx - 1));\
			}\
		} regname


