target ptrbits 32

global @rv32_data i32 align 4 = 0

func @rv32_add(i32 %0, i32 %1) -> i32 {
^entry:
  %2 = add i32 %0, %1
  ret i32 %2
}

func @rv32_nine(i32 %0, i32 %1, i32 %2, i32 %3, i32 %4, i32 %5, i32 %6, i32 %7, i32 %8) -> i32 {
^entry:
  ret i32 %8
}

func @rv32_sign_extend(i16 %0) -> i32 {
^entry:
  %1 = sext i16 %0 to i32
  ret i32 %1
}

func @rv32_zero_extend(i16 %0) -> i32 {
^entry:
  %1 = zext i16 %0 to i32
  ret i32 %1
}

func @rv32_compare(i32 %0) -> i32 {
^entry:
  %1 = const i32 0
  %2 = icmp eq i32 %0, %1
  jmp i1 %2, ^zero, ^nonzero
^zero:
  %3 = const i32 1
  ret i32 %3
^nonzero:
  %4 = const i32 2
  ret i32 %4
}

func @rv32_main() -> i32 {
^entry:
  %0 = local i32 align 4
  %1 = const i32 19
  store i32 %1, %0 align 4
  %2 = load i32, %0 align 4
  %3 = const i32 23
  %4 = call i32 @rv32_add(i32 %2, i32 %3)
  store i32 %4, %0 align 4
  %5 = load i32, %0 align 4
  %6 = const i32 1
  %7 = const i32 2
  %8 = const i32 3
  %9 = const i32 4
  %10 = const i32 5
  %11 = const i32 6
  %12 = const i32 7
  %13 = const i32 8
  %14 = const i32 9
  %15 = call i32 @rv32_nine(i32 %6, i32 %7, i32 %8, i32 %9, i32 %10, i32 %11, i32 %12, i32 %13, i32 %14)
  ret i32 %15
}
