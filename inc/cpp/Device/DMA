#if defined(_MCU_STM32F4x) || defined(_MCU_STM32H7x) || defined(_MPU_STM32MP13)
	class DMAStream {
	protected:
		DMAReg::DMARegType refIFCR() const {
			using namespace DMAReg;
			return getID() & 0b100 ? HIFCR : LIFCR;
		}
		// base bit offset of this stream's 6-bit flag block in LISR/HISR (and LIFCR/HIFCR)
		byte flagBase() const {
			byte posi = 0;
			if (getID() & 0b010) posi += 16;
			if (getID() & 0b001) posi += 6;
			return posi;
		}

	public:
		const DMAChannel& operator[](unsigned chan) const {
			return *(const DMAChannel*)(_IMM(this) | chan);
		}
		DMA_t& getParent(void) const {
			return DMA[_IMM(this) >> 8];
		}

		stduint getID() const {
			return (_IMM(this) >> 4) & 0b111;
		}

		void enAble(bool ena = true) const {
			using namespace DMAReg;
			DMA_t& sel = getParent();
			sel[CR[getID()]].setof(_DMA_SxCR_POS_EN, ena);
			while (sel[CR[getID()]].bitof(_DMA_SxCR_POS_EN) != ena);
		}

		// cancel working modes, aka HAL_DMA_DeInit
		void canMode(void) const;

		void ClearInterruptFlags() const {
			using namespace DMAReg;
			DMA_t& sel = getParent();
			sel[refIFCR()].maset(flagBase(), 6, 0x3F);
		}

		// aka DMA_SetConfig
		void setTransfer(pureptr_t dst_addr, pureptr_t src_addr, stduint leng) const {
			using namespace DMAReg;
			DMA_t& sel = getParent();
			byte st = getID();
			sel[CR[st]].setof(_DMA_SxCR_POS_DBM, false);// clear DBM (aka DMA_SetConfig)
			bool m2p = 1 == sel[CR[st]].masof(_DMA_SxCR_POS_DIR, 2); // DIR
			sel[NDTR[st]] = leng;
			sel[PAR[st]] = _IMM(m2p ? dst_addr : src_addr);
			sel[M0AR[st]] = _IMM(m2p ? src_addr : dst_addr);
		}

		// type: 1:TCIE, 2:HTIE, 3:TEIE, 4:DMEIE
		void enInterrupt(bool ena = true, byte type = 1) const {
			using namespace DMAReg;
			DMA_t& sel = getParent();
			Reference cr = sel[CR[getID()]];
			switch (type) {
			case 1: cr.setof(_DMA_SxCR_POS_TCIE, ena); break;
			case 2: cr.setof(_DMA_SxCR_POS_HTIE, ena); break;
			case 3: cr.setof(_DMA_SxCR_POS_TEIE, ena); break;
			case 4: cr.setof(_DMA_SxCR_POS_DMEIE, ena); break;
			}
		}

		// enable TCIE/TEIE/DMEIE (+HTIE if a half-callback is registered) and FEIE
		void setInterruptSub(bool ena_total) const {
			using namespace DMAReg;
			DMA_t& sel = getParent();
			Reference cr = sel[CR[getID()]];
			cr.setof(_DMA_SxCR_POS_TCIE, ena_total);
			cr.setof(_DMA_SxCR_POS_TEIE, ena_total);
			cr.setof(_DMA_SxCR_POS_DMEIE, ena_total);
			cr.setof(_DMA_SxCR_POS_HTIE, ena_total && (sel.XferHalfCallback || sel.XferM1HalfCpltCallback));
			sel[FCR[getID()]].setof(_DMA_SxFCR_POS_FEIE, ena_total);
		}

		void setInterruptPriority(byte preempt, byte sub_priority) const;
		void enInterruptNVIC(bool ena = true) const;

		// select the peripheral request source.
		//   F4: writes SxCR.CHSEL (fixed mapping; request_id is the channel number 0..7)
		//   H7: writes DMAMUX1 channel CCR (request_id is the DMAMUX request line ID; see RM)
		void setRequest(stduint request_id) const;

		// aka HAL_DMA_GetState
		byte getState() const { return getParent().streamStates[getID()]; }
		// aka HAL_DMA_GetError
		uint32 getError() const { return getParent().streamErrors[getID()]; }

		// aka HAL_DMA_Start / HAL_DMA_Start_IT / HAL_DMA_PollForTransfer (unified)
		//   Loop : configure + enable + poll TCIF with timeout (blocking)
		//   Rupt : configure + enable stream interrupts + NVIC + enable (async, callback)
		bool Transfer(pureptr_t dst_addr, pureptr_t src_addr, stduint leng, IOMethod method = IOMethod::Loop) const;

		// aka HAL_DMA_Abort (blocking): disable IT + EN, wait EN=0 (timeout), clear flags
		bool Abort() const;

		// aka HAL_DMA_Abort_IT (non-blocking): disable EN, XferAbortCallback called from IRQ
		bool AbortRupt() const;

		// AKA HAL_DMAEx_MultiBufferStart / HAL_DMAEx_MultiBufferStart_IT
		// Memory-to-memory transfer not supported in double buffering mode.
		// When Double Buffer mode is enabled, the transfer is circular by default.
		// Rupt callbacks: XferCpltCallback for M0 completion, XferM1CpltCallback for M1.
		// If half callbacks are registered (XferHalfCallback / XferM1HalfCpltCallback), HTIE enabled.
		bool MultiBufferTransfer(pureptr_t dst_addr, pureptr_t src_addr, pureptr_t second_mem, stduint leng, IOMethod method = IOMethod::Loop) const;
		// AKA HAL_DMAEx_ChangeMemory: switch M0AR or M1AR on the fly (only when current target is the other buffer)
		void ChangeMemory(pureptr_t addr, MemorySel mem) const;
#if defined(_MCU_STM32H7x) || defined(_MPU_STM32MP13)
		// AKA HAL_DMAEx_ConfigMuxSync: configure DMAMUX synchronization for this stream
		// Clears SE+EGE before applying new config; keeps existing DMAREQ_ID.
		//  - signal_id: sync signal ID (RM0433 Table 57 / Table 69)
		//  - pol: sync trigger polarity (NoPolarity only valid when ena=false)
		//  - request_num: number of DMA requests authorized per sync event (1..32)
		//  - event_ena: if true, generates event when NBREQ counter reaches zero
		bool setMuxSync(stduint signal_id, MuxPolarity pol, bool ena = true, bool event_ena = false, stduint request_num = 1) const;
		// AKA HAL_DMAEx_ConfigMuxRequestGenerator: configure DMAMUX request generator
		// RequestGenerator must be disabled (GE=0) before configuring.
		bool ConfigRequestGenerator(stduint signal_id, MuxPolarity pol, stduint request_num) const;
		// AKA HAL_DMAEx_EnableMuxRequestGenerator / DisableMuxRequestGenerator
		bool EnableRequestGenerator(bool ena = true) const;
		// AKA HAL_DMAEx_MUX_IRQHandler: handle DMAMUX sync/request-gen overrun for this stream
		void HandleMuxIRQ(void) const;
#endif

	};

	class DMAChannel {
	public:
		enum FIFOThreshold {
			_1QuarterFull = 0, _1HalfFull, _3QuarterFull, _Full
		};
#if defined(_MPU_STM32MP13)
		// aka HAL DMA_MBURST_* / DMA_PBURST_* (memory/peripheral burst, 2-bit CR field)
		enum class Burst : byte { Single = 0, Inc4, Inc8, Inc16 };
#endif
		byte getID() const {
			return _IMM(this) & 0b111;
		}
		const DMAStream& getParent(void) const {
			return *(const DMAStream*)(_IMM(this) & 0x370);
		}
		// aka HAL_DMA_Init
		bool setMode(
			bool from_periph, bool to_periph,
			bool periph_inc = false, bool memory_inc = false,
			bool circular_mode = true,
			stduint periph_align = 2 /*byte*/, stduint memory_align = 2 /*byte*/,
			byte priority = 1) const;

		void setTransfer(pureptr_t dst_addr, pureptr_t src_addr, stduint leng) const {
			getParent().setTransfer(dst_addr, src_addr, leng);
		}

		void setFIFOThreshold(DMAChannel::FIFOThreshold hold) const;
#if defined(_MPU_STM32MP13)
		// aka HAL_DMA_Init FIFO part + DMA_CheckFifoParam
		bool setFIFO(bool ena, Burst mem_burst = Burst::Single, Burst periph_burst = Burst::Single, FIFOThreshold threshold = _Full) const;
#endif

		void setRequest(stduint request_id) const {
			getParent().setRequest(request_id);
		}

		byte getState() const { return getParent().getState(); }
		uint32 getError() const { return getParent().getError(); }
		bool Transfer(pureptr_t dst_addr, pureptr_t src_addr, stduint leng, IOMethod method = IOMethod::Loop) const {
			return getParent().Transfer(dst_addr, src_addr, leng, method);
		}
		bool Abort() const { return getParent().Abort(); }
		bool AbortRupt() const { return getParent().AbortRupt(); }
	#if (defined(_MCU_STM32F4x) || defined(_MCU_STM32H7x) || defined(_MPU_STM32MP13))
		bool MultiBufferTransfer(pureptr_t dst_addr, pureptr_t src_addr, pureptr_t second_mem, stduint leng, IOMethod method = IOMethod::Loop) const {
			return getParent().MultiBufferTransfer(dst_addr, src_addr, second_mem, leng, method);
		}
		void ChangeMemory(pureptr_t addr, MemorySel mem) const { getParent().ChangeMemory(addr, mem); }
	#endif
	#if defined(_MCU_STM32H7x) || defined(_MPU_STM32MP13)
		bool setMuxSync(stduint signal_id, MuxPolarity pol, bool ena = true, bool event_ena = false, stduint request_num = 1) const {
			return getParent().setMuxSync(signal_id, pol, ena, event_ena, request_num);
		}
		bool ConfigRequestGenerator(stduint signal_id, MuxPolarity pol, stduint request_num) const {
			return getParent().ConfigRequestGenerator(signal_id, pol, request_num);
		}
		bool EnableRequestGenerator(bool ena = true) const { return getParent().EnableRequestGenerator(ena); }
	#endif

	};
