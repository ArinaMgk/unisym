#ifndef _INCPP_Utility
#define _INCPP_Utility

#include "../unisym"
#include "type_traits"

namespace uni {

	template <typename type>
	constexpr RemoveReferenceT<type>&& move(type&& arg) noexcept {
		return static_cast<RemoveReferenceT<type>&&>(arg);
	}

	template <typename type>
	constexpr type&& forward(RemoveReferenceT<type>& arg) noexcept {
		return static_cast<type&&>(arg);
	}

	template <typename type>
	constexpr type&& forward(RemoveReferenceT<type>&& arg) noexcept {
		return static_cast<type&&>(arg);
	}

	template <typename type>
	inline void swap(type& a, type& b) {
		type temp = static_cast<type&&>(a);
		a = static_cast<type&&>(b);
		b = static_cast<type&&>(temp);
	}

	template <typename type, stduint dim>
	inline void swap(type (&a)[dim], type (&b)[dim]) {
		for (stduint i = 0; i < dim; i++) uni::swap(a[i], b[i]);
	}

}

#if !defined(_HAS_STD_UTILITY)

