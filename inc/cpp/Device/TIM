	class TIM_CHAN_t;
	class DMAStream; // forward: DMAStream* member below; full type only on F4/H7 (MP13 defers DMA)
	class TIM_t : public RuptTrait {
	protected:
		stduint baseaddr;
		byte TIM_ID;
	public:
		Handler_t FUNC_IC_Capture;
		Handler_t FUNC_OC_DelayElapsed;
		Handler_t FUNC_PWMPulseFinished;
		Handler_t FUNC_Break;
		Handler_t FUNC_Trigger;
		Handler_t FUNC_Commute;
		volatile byte last_src;
		// DMA stream handles: 0 = Update event, 1~4 = CC1~CC4 (aka HAL htim->hdma[])
		DMAStream* dma[5];
		// Base update-event DMA: mem -> ARR (aka HAL_TIM_Base_Start_DMA)
		bool UpdateDMA(pureptr_t data, stduint leng, IOMethod method = IOMethod::Rupt);
		TIM_t(stduint baseaddr, byte TIM_ID) : baseaddr(baseaddr), TIM_ID(TIM_ID) {
			FUNC_IC_Capture = 0;
			FUNC_OC_DelayElapsed = 0;
			FUNC_PWMPulseFinished = 0;
			FUNC_Break = 0;
			FUNC_Trigger = 0;
			FUNC_Commute = 0;
			last_src = nil;
			for (byte i = 0; i < 5; i++) dma[i] = 0;
		}
		Reference operator[](TimReg::TimRegType trt) {
			return Reference(baseaddr + _IMMx4(trt));
		}
		TIM_CHAN_t operator[](stduint chan_id);
		stduint getBaseaddr() const { return baseaddr; }
		byte getID() const { return TIM_ID; }
		_COM_DEF_Interrupt_Interface();
		void enClock(bool ena = true) {
			if (!TIM_ID) return;
#if defined(_MPU_STM32MP13)
			// MP13 RCC: TIM1/8 (APB2), TIM2~7 (APB1), TIM12~17 (APB6)
			stduint refaddr;
			byte width;
			if (TIM_ID == 1 || TIM_ID == 8) {
				refaddr = _RCC_ADDR + (ena ? 0x708 : 0x70C); // APB2ENSETR / APB2ENCLRR
				width = TIM_ID - 1; // TIM1 = 0, TIM8 = 1
			}
			else if (Ranglin(TIM_ID, 2, 6)) { // TIM 2~7
				refaddr = _RCC_ADDR + (ena ? 0x700 : 0x704); // APB1ENSETR / APB1ENCLRR
				width = TIM_ID - 2;
			}
			else if (Ranglin(TIM_ID, 12, 6)) { // TIM 12~17
				refaddr = _RCC_ADDR + (ena ? 0x748 : 0x74C); // APB6ENSETR / APB6ENCLRR
				width = TIM_ID - 5; // TIM12 = 7 .. TIM17 = 12
			}
			else return;
			Reference(refaddr).operator=(_IMM1S(width));
#else
			byte width = 0;
#if defined(_MCU_STM32H7x)
			// H7 D2 domain: APB1LENR for TIM2~7, APB2ENR for TIM1/8
			stduint refaddr = _RCC_ADDR + 0xE8; // APB1LENR
			if (TIM_ID == 1) {
				refaddr = _RCC_ADDR + 0xF0; // APB2ENR
				width = 0;
			}
			else if (TIM_ID == 8) {
				refaddr = _RCC_ADDR + 0xF0; // APB2ENR
				width = 1;
			}
			else if (Ranglin(TIM_ID, 2, 6)) { // TIM 2~7
				width = TIM_ID - 2;
			}
			else _TODO;
#else
			stduint refaddr = _RCC_APB1ENR_ADDR;
			if (TIM_ID == 1) {
				refaddr = _RCC_APB2ENR_ADDR;
#if defined(_MCU_STM32F1x)
				width = 11;
#else
				width = 0; // F4: TIM1 is APB2 bit 0
#endif
			}
			else if (TIM_ID == 8) {
				refaddr = _RCC_APB2ENR_ADDR;
				width = 1; // F4: TIM8 is APB2 bit 1
			}
			else if (Ranglin(TIM_ID, 2, 6)) { // TIM 2~7
				width = TIM_ID - 2;
			}
			else _TODO;
#endif
			Reference(refaddr).setof(width, ena);
#endif
		}
		void enAble(bool ena = true) {
			using namespace TimReg;
			self[CR1].setof(_TIM_CR1_POS_CEN, ena);
		}
		void ConfigMaster(_TEMP stduint master_output_triggerm = 0, bool master_slave_enable = false);//{TO private}
		bool WantedSource(byte src) {
			return last_src == src;
		}
		// Reset the timer to its default state (aka HAL_TIM_*_DeInit):
		// stop counter, clear all registers, then gate the peripheral clock.
		bool canMode();
		// Enable/disable capture/compare interrupt for a channel (DIER.CCxIE)
		void enCCInterrupt(byte channel, bool ena = true) {
			if (!Ranglin(channel, 1, 4)) return;
			using namespace TimReg;
			self[DIER].setof(channel, ena);
		}
		// Enable/disable trigger interrupt (DIER.TIE; advanced timers also toggle the TRG_COM IRQ line)
		void enTriggerInterrupt(bool ena = true);
		// Enable/disable break interrupt (DIER.BIE + the BRK IRQ line, advanced timers only)
		void enBreakInterrupt(bool ena = true);
	};

