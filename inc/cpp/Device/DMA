// MEMMAP:
// 0x0000_01AB DMA1
// 0x0000_02AB DMA2
// - AA: Number of the Channel
// - BB: Number of the Stream

#define _DEV_MASK_DMA 0x377 // 0b11_0111_0111

// DMA transfer state (mirrors HAL_DMA_StateTypeDef)
#define _DMA_STATE_RESET  0x00
#define _DMA_STATE_READY  0x01
#define _DMA_STATE_BUSY   0x02
#define _DMA_STATE_TIMEOUT 0x03
#define _DMA_STATE_ERROR  0x04
#define _DMA_STATE_ABORT  0x05

// DMA error codes (bitmask, mirrors HAL_DMA_ERROR_*)
#define _DMA_ERROR_NONE          0x00000000U
#define _DMA_ERROR_TE            0x00000001U
#define _DMA_ERROR_FE            0x00000002U
#define _DMA_ERROR_DME           0x00000004U
#define _DMA_ERROR_BUSY          0x00000010U
#define _DMA_ERROR_TIMEOUT       0x00000020U
#define _DMA_ERROR_PARAM         0x00000040U
#define _DMA_ERROR_NO_XFER       0x00000080U
#define _DMA_ERROR_NOT_SUPPORTED 0x00000100U
#define _DMA_ERROR_SYNC          0x00000200U
#define _DMA_ERROR_REQGEN        0x00000400U

// Default timeout for DMA polling/abort (same scale as XART_TIMEOUT_VALUE)
#define DMA_TIMEOUT_VALUE 0x1FFFFFFU

