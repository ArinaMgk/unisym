#ifndef _INC_DEVICE_Flash
#define _INC_DEVICE_Flash

#include "../unisym"
#include "../reference"

#if defined(_MCU_STM32F1x) || defined(_MCU_STM32F4x)

#endif// _MCU_STM32F1x || _MCU_STM32F4x

#ifdef _MCU_STM32F1x



#elif defined(_MCU_STM32F4x)

#define _Flash_ADDR 0x40023C00 //~ 0x40023CFF
#define _Flash_ACR_POSI_PRFTEN 8

namespace uni {

	namespace FlashReg {
		typedef enum {
			ACR = 0, KEYR, OPTKEYR, SR,
			CR, OPTCR
		} FlashReg;
	}
	
	class Flash_t {
	public:
		Reference operator[](FlashReg::FlashReg idx) {
			return Reference(_Flash_ADDR + (_IMM(idx) << 2));
		}

	};
	extern Flash_t Flash;// yo RCC!
}

#elif defined(_MCU_STM32H7x)

#include "../../c/driver/_predefine/predef.flash.hpp"
#include "../trait/StorageTrait.hpp"
#include "../interrupt"
#include "MDMA"// IOMethod (guarded shared enum; DMA unused by flash)

#define _Flash_ADDR (D1_AHB1PERIPH_BASE + 0x2000)

// global ISR entry (extern "C"; defined in interrupt_flash.hpp), friended below
extern "C" void FLASH_IRQHandler();

namespace uni {

	namespace FlashReg {
		typedef enum {
		ACR,                // FLASH access control register
		KEYR1,              // Flash Key Register for bank1
		OPTKEYR,            // Flash Option Key Register
		CR1,                // Flash Control Register for bank1
		SR1,                // Flash Status Register for bank1
		CCR1,               // Flash Control Register for bank1
		OPTCR,              // Flash Option Control Register
		OPTSR_CUR,          // Flash Option Status Current Register
		OPTSR_PRG,          // Flash Option Status Current Register
		OPTCCR,             // Flash Option Clear Control Register
		PRAR_CUR1,          // Flash Current Protection Address Register for bank1
		PRAR_PRG1,          // Flash Protection Address to Program Register for bank1
		SCAR_CUR1,          // Flash Current Secure Address Register for bank1
		SCAR_PRG1,          // Flash Secure Address Register for bank1
		WPSN_CUR1,          // Flash Current Write Protection Register on bank1
		WPSN_PRG1,          // Flash Write Protection to Program Register on bank1
		BOOT_CUR,           // Flash Current Boot Address for Pelican Core Register
		BOOT_PRG,           // Flash Boot Address to Program for Pelican Core Register
		CRCCR1 = 0x50/4,    // Flash CRC Control register For Bank1 Register
		CRCSADD1,           // Flash CRC Start Address Register for Bank1
		CRCEADD1,           // Flash CRC End Address Register for Bank1
		CRCDATA,            // Flash CRC Data Register for Bank1
		ECC_FA1,            // Flash ECC Fail Address For Bank1 Register
		KEYR2 = 0x104/4,    // Flash Key Register for bank2
		CR2 = 0x10C/4,      // Flash Control Register for bank2
		SR2,                // Flash Status Register for bank2
		CCR2,               // Flash Status Register for bank2
		PRAR_CUR2 = 0x128/4,// Flash Current Protection Address Register for bank2
		PRAR_PRG2,          // Flash Protection Address to Program Register for bank2
		SCAR_CUR2,          // Flash Current Secure Address Register for bank2
		SCAR_PRG2,          // Flash Secure Address Register for bank2
		WPSN_CUR2,          // Flash Current Write Protection Register on bank2
		WPSN_PRG2,          // Flash Write Protection to Program Register on bank2
		CRCCR2 = 0x150/4,   // Flash CRC Control register For Bank2 Register
		CRCSADD2,           // Flash CRC Start Address Register for Bank2
		CRCEADD2,           // Flash CRC End Address Register for Bank2
		CRCDATA2,           // Flash CRC Data Register for Bank2
		ECC_FA2,            // Flash ECC Fail Address For Bank2 Register
		} FlashReg;
	}

	// option bytes readback (AKA HAL_FLASHEx_OBGetConfig output)
	struct OptionBytesConfig_t {
		byte read_protection;      // RDP level 0/1/2
		byte bor_level;            // BOR level 1/2/3
		stduint write_protection1; // WPSN_CUR1 sector mask (bank1)
		stduint write_protection2; // WPSN_CUR2 sector mask (bank2)
		stduint boot_addr0;        // BOOT_ADD0
		stduint boot_addr1;        // BOOT_ADD1
		stduint code_read_start;   // PRAR_CUR start address
		stduint code_read_end;     // PRAR_CUR end address
		stduint secure_area_start; // SCAR_CUR start address
		stduint secure_area_end;   // SCAR_CUR end address
		stduint user_options;      // OPTSR_CUR user bits
	};

	// AKA HAL_FLASH_HandleTypeDef + StorageTrait (block device, 32-byte row granularity)
	class Flash_t : public StorageTrait, public RuptTrait {
	public:
		Flash_t() { Block_Size = _FLASH_ROW_SIZE; readable = true; writable = true; }

		// AKA HAL_FLASH_Unlock / Lock (KEYR1 + CR1.LOCK)
		bool Unlock();
		void Lock();

		// AKA HAL_FLASH_Program / _IT (256-bit row at addr; Loop polls, Rupt raises EOP)
		bool Program(stduint addr, const void* data, IOMethod method = IOMethod::Loop);
		// AKA HAL_FLASHEx_Erase / _IT: erase one sector of a bank
		bool Erase(byte bank, byte sector, IOMethod method = IOMethod::Loop);
		// AKA HAL_FLASHEx_Erase / _IT: mass erase a bank
		bool Erase(byte bank, IOMethod method = IOMethod::Loop);

		// StorageTrait: 32-byte row granularity
		// Read(block, buf): read 32 bytes at absolute addr = FLASH_BASE + block*32
		// Write(block, buf): auto-erase sector then program the row
		virtual bool Read(stduint block, void* dest) override;
		virtual bool Write(stduint block, const void* src) override;
		virtual stduint getUnits() override { return (_FLASH_SECTOR_TOTAL * _FLASH_SECTOR_SIZE) / _FLASH_ROW_SIZE; }
		virtual int operator[](uint64 bytid) override;

		// callbacks (AKA HAL_FLASH_EndOfOperationCallback / OperationErrorCallback)
		Handler_t EndOfOperationHandler = 0;
		Handler_t OperationErrorHandler = 0;

		// AKA HAL_FLASH_GetError
		stduint getError() const { return ErrorCode; }

		// ---- option bytes (AKA HAL_FLASH_OB_* / HAL_FLASHEx_OBProgram / OBGetConfig) ----
		bool OB_Unlock();
		void OB_Lock();
		bool OB_Launch();
		bool setReadProtection(byte level);       // RDP 0/1/2
		bool setWriteProtection(byte bank, stduint sector_mask);
		bool setBORLevel(byte level);             // BOR 1/2/3
		bool setBootAddress(byte which, stduint addr); // which 0/1/2 = ADD0/ADD1/both
		bool setCodeReadProtection(byte bank, stduint start, stduint end);
		bool setSecureArea(byte bank, stduint start, stduint end);
		bool setUserOption(stduint mask, stduint value);
		bool getOptionBytesConfig(OptionBytesConfig_t& cfg);

		// register access
		Reference operator[](FlashReg::FlashReg idx);

		// RuptTrait (NVIC + IRQ_FLASH)
		_COM_DEF_Interrupt_Interface();

	protected:
		// interrupt-mode process state (AKA tail of FLASH_ProcessTypeDef)
		volatile stduint Procedure = _FLASH_PROC_NONE;
		stduint Address = 0;   // program address for IRQ dispatch
		stduint ErrorCode = 0; // last error flags

		// ISR entry (global, extern "C", defined in interrupt_flash.hpp)
		friend void ::FLASH_IRQHandler();
	};
	extern Flash_t Flash;// yo RCC!
}

#endif
#endif


