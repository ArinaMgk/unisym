#ifndef _INC_Device_SRAM
#define _INC_Device_SRAM

#include "../unisym"
#include "../reference"
#include "MDMA"
#include "../../c/driver/_predefine/predef.fmc.hpp"

namespace uni {

#if defined(_MCU_STM32H7x)

	// External async SRAM/PSRAM via FMC NORSRAM Bank1~4 (AKA stm32h7xx_hal_sram + ll_fmc NORSRAM)
	class SRAM_t {
	protected:
		stduint baseaddr;                       // FMC_Bank1_R_BASE (BTCR[0..7])
		stduint extaddr;                        // FMC_Bank1E_R_BASE (BWTR[0..6])
		SRAMInit Init;                          // AKA hsram->Init
		SRAMState State = SRAMState::Reset;     // AKA hsram->State
		inline Reference btcr(stduint word) const { return Reference(baseaddr + (word << 2)); }
		inline Reference bwtr(stduint word) const { return Reference(extaddr + (word << 2)); }
	public:
		byte mdmaChannel = 0;                   // MDMA channel for Read/Write DMA (user configures MDMA[mdmaChannel])

		SRAM_t(stduint base, stduint ext) : baseaddr(base), extaddr(ext) {}

		// AKA HAL_SRAM_Init
		bool setMode(const SRAMInit& init, const SRAMTiming& timing, const SRAMTiming& extTiming);
		// AKA HAL_SRAM_DeInit
		bool canMode();
		// AKA HAL_SRAM_Read_8b/16b/32b (+ Read_DMA via IOMethod::DMA, 32-bit only)
		bool Read(pureptr_t addr, pureptr_t buf, stduint size, SRAMWidth w, IOMethod method = IOMethod::Loop);
		// AKA HAL_SRAM_Write_8b/16b/32b (+ Write_DMA via IOMethod::DMA, 32-bit only)
		bool Write(pureptr_t addr, pureptr_t buf, stduint size, SRAMWidth w, IOMethod method = IOMethod::Loop);
		// AKA HAL_SRAM_WriteOperation_Enable/Disable
		bool setWriteOperation(bool ena);
		// AKA HAL_SRAM_GetState
		SRAMState getState() const { return State; }
	};

	extern SRAM_t SRAM;

#endif // _MCU_STM32H7x

}

#endif // _INC_Device_SRAM
