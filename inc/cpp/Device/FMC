#ifndef _INC_Device_FMC
#define _INC_Device_FMC

#include "../unisym"
#include "../reference"
#include "MDMA"
#include "../../c/driver/_predefine/predef.fmc.hpp"

namespace uni {

#if defined(_MCU_STM32H7x)

	// SDRAM sub-interface of FMC (AKA stm32h7xx_hal_sdram + ll_fmc Bank5/6)
	class FMC_SDRAM_t {
	protected:
		stduint baseaddr;                          // FMC_Bank5_6_R_BASE
		SDRAMInit Init;                            // AKA hsdram->Init
		SDRAMState State = SDRAMState::Reset;      // AKA hsdram->State
		inline Reference operator[](FMC_SDRAMReg idx) const { return Reference(baseaddr + ((stduint)idx << 2)); }
	public:
		Handler_t RefreshErrorCallback = 0;        // AKA HAL_SDRAM_RefreshErrorCallback
		byte mdmaChannel = 0;                      // MDMA channel for Read/Write DMA (user configures MDMA[mdmaChannel] + callbacks)

		FMC_SDRAM_t(stduint base) : baseaddr(base) {}

		// AKA HAL_SDRAM_Init
		bool setMode(const SDRAMInit& init, const SDRAMTiming& timing);
		// AKA HAL_SDRAM_DeInit
		bool canMode();
		// AKA HAL_SDRAM_Read_8b/16b/32b (+ Read_DMA via IOMethod::DMA, 32-bit only)
		bool Read(pureptr_t addr, pureptr_t buf, stduint size, SDRAMWidth w, IOMethod method = IOMethod::Loop);
		// AKA HAL_SDRAM_Write_8b/16b/32b (+ Write_DMA via IOMethod::DMA, 32-bit only)
		bool Write(pureptr_t addr, pureptr_t buf, stduint size, SDRAMWidth w, IOMethod method = IOMethod::Loop);
		// AKA HAL_SDRAM_WriteProtection_Enable/Disable
		bool setWriteProtection(bool ena);
		// AKA HAL_SDRAM_SendCommand
		bool setCommand(const SDRAMCommand& cmd);
		// AKA HAL_SDRAM_ProgramRefreshRate
		bool setRefreshRate(uint32 rate);
		// AKA HAL_SDRAM_SetAutoRefreshNumber
		bool setAutoRefreshNumber(uint32 n);
		// AKA HAL_SDRAM_GetModeStatus
		uint32 getModeStatus();
		// AKA HAL_SDRAM_GetState
		SDRAMState getState() const { return State; }
		// AKA HAL_SDRAM_IRQHandler (refresh error)
		void IRQHandler();
	};

	// FMC umbrella (NOR/NAND/SRAM future; this round only SDRAM)
	class FMC_t {
	public:
		FMC_SDRAM_t SDRAM;
		FMC_t() : SDRAM(FMC_Bank5_6_R_BASE) {}
	};

	extern FMC_t FMC;

#endif // _MCU_STM32H7x

}

#endif // _INC_Device_FMC
