	// AKA HAL_ADC_CallbackIDTypeDef (single-callback model: regular conversion complete)
	enum class ADCCallbackID : byte {
		ConvCplt = 0// AKA HAL_ADC_ConvCpltCallback
	};
#if defined(_MPU_STM32MP13)
